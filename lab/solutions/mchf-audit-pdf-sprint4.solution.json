                "apiId": "/providers/lab/apis/shared_lists",
                "connectionName": "shared_lists",
                "operationId": "GetItems"
              },
              "parameters": {
                "table": "6a977a12-85bc-4c5f-81c5-5bd5268b7a74",
                "$filter": "Submission_x0020_Reference eq '@{outputs('Get_submission')?['body/Title']}'"
