              ]
            },
            "runAfter": {
              "Get_pledge_installments": [
                "Succeeded"
              ]
            }
          },
          "Initialize_variable_2": {
            "type": "InitializeVariable",
            "inputs": {
              "variables": [
                {
                  "name": "total",
                  "type": "float",
                  "value": 0
                }
              ]
